# 개발용 이미지
# 운영 이미지(harbor.cu.ac.kr/patheditor/patheditor)와 동일한 python:3.10-slim 베이스에
# requirements.txt 의존성을 설치하고, 코드 hot-reload용 watchfiles 를 추가한다.
# 사설 레지스트리(harbor) 접근 없이도 빌드되도록 베이스에서 직접 구성하므로
# 운영과 동일한 의존성 환경을 어디서든 재현할 수 있다.
# 애플리케이션 코드는 빌드 시 굽지 않고 docker-compose.dev.yml 의 bind mount 로 주입한다.
FROM python:3.10-slim

WORKDIR /app/backend

# 운영과 동일한 의존성 + hot-reload용 watchfiles
# (uvicorn 0.24는 [standard] 미설치 시 --reload용 파일 와처가 없어 watchfiles 필요)
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt watchfiles

# 컨테이너 환경의 데이터 경로 (path_service.py 가 우선 참조)
ENV APP_DATA_DIR=/app/backend/data/path

EXPOSE 8000
